{
  "version": 2,
  "builds": [
    {
      "src": "back/node.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "scripts.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "back/node.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}